#!/usr/bin/env groovy

// This pipeline is designed to be used with a multibranch pipeline job in Jenkins.
// @Library("jenkins-shared-lib") // Global library declaration from Jenkins server configuration
// library identifier: "jenkins-shared-lib@master", retriever: modernSCM([$class: "GitSCMSource", remote: "https://github.com/PeterOyelegbin/jenkins-shared-lib.git", credentialsID: "github-cred"]) // Individual library declaration

def gv

pipeline {
    agent any
    parameters {
        string(name: "IMAGE_TAG", defaultValue: "", description: "Tag to build and deploy (defaults to BUILD_NUMBER if empty)")
    }
    environment {
        // Fallback to BUILD_NUMBER if IMAGE_TAG wasn't manually provided
        DEPLOY_TAG = "${params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER}"
    }
    stages {
        stage("init") {
            steps {
                checkout scm
                dir("fastapi") {
                    script {
                        gv = load "script.groovy"
                    }
                }
            }
        }
        stage("test") {
            steps {
                dir("fastapi") {
                    script {
                        echo "testing the application ..."
                        echo "Executing pipeline for branch $BRANCH_NAME"
                        sh '''
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                            pytest -v test.py
                        '''
                    }
                }
            }
        }
        stage("build") {
            when {
                expression {BRANCH_NAME == "main"}
            }
            // input {
            //     message "Enter image tag to deploy"
            //     ok "Done"
            //     parameters {string(name: "IMAGE_TAG", defaultValue: "", description: "tag to deploy")}
            // }
            steps {
                dir("fastapi") {
                    script {
                        echo "Building image with tag ${env.DEPLOY_TAG}..."
                        gv.buildImage(env.DEPLOY_TAG)
                    }
                }
            }
        }
        stage("deploy") {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "deploying the application ..."
                }
            }
        }
    }
    post {
        always {
            // Clean up workspace after build to save disk space
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed! Check the test logs or build output."
        }
    }
}
