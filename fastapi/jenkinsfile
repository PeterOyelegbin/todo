#!/usr/bin/env groovy

// This pipeline is designed to be used with a multibranch pipeline job in Jenkins.
// @Library("jenkins-shared-lib") // Global library declaration from Jenkins server configuration
// library identifier: "jenkins-shared-lib@master", retriever: modernSCM([$class: "GitSCMSource", remote: "https://github.com/PeterOyelegbin/jenkins-shared-lib.git", credentialsID: "github-cred"]) // Individual library declaration

pipeline {
    agent any
    stages {
        stage("test") {
            steps {
                script {
                    echo "testing the application ..."
                    echo "Executing pipeline for branch $BRANCH_NAME"
                    sh "pytest test.py"
                }
            }
        }
        stage("build") {
            when {
                expression {BRANCH_NAME == "main"}
            }
            steps {
                script {
                    echo "building the application ..."
                }
            }
        }
        stage("deploy") {
            when {
                expression {BRANCH_NAME == "main"}
            }
            steps {
                script {
                    echo "deploying the application ..."
                }
            }
        }
    }
}
